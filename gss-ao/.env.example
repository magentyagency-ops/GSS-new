# ============================================================================
# .env.example — copier en .env et adapter. NE PAS committer .env (cf. .gitignore)
# ============================================================================

# --- Corpus (chemins locaux, hors dépôt git) ---------------------------------
# Par défaut, relatifs à la racine du workspace (parent de gss-ao/).
CORPUS_DCE_DIR=../Cas-Univ-Rouen-MP2026-08
CORPUS_SLIDE_REP_AO_DIR=../SLIDE REP AO

# --- Conversion .doc legacy --------------------------------------------------
# Laisser vide pour auto-détection (PATH + /Applications/LibreOffice.app).
SOFFICE_BIN=

# --- OCR (fallback optionnel, désactivé par défaut) --------------------------
OCR_ENABLED=false
TESSERACT_BIN=
OCR_LANG=fra

# --- RAG : embeddings --------------------------------------------------------
# Provider : voyage | openai | bge_local | none (dry-run sans calcul réel)
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- RAG : vector store ------------------------------------------------------
# Backend : jsonl (dry-run local) | pgvector
VECTOR_STORE=jsonl
VECTOR_STORE_JSONL_PATH=data/output/slide_rep_ao_chunks.jsonl

# --- PostgreSQL / pgvector (utilisé si VECTOR_STORE=pgvector) ----------------
DATABASE_URL=postgresql+psycopg://gss:gss@localhost:5432/gss_ao

# --- LLM (non appelé en itération 1) -----------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_LONG=claude-sonnet-4-6
LLM_MODEL_UTILITY=claude-haiku-4-5-20251001

# --- Stockage objets (S3/MinIO — Module A, non implémenté) -------------------
S3_ENDPOINT_URL=
S3_BUCKET=gss-ao
